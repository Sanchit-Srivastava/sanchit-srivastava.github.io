---
---
<article class="publication-entry" id="{{ entry.key }}">
  <header>
    <h3>{{ entry.title }}</h3>
    <p class="publication-authors">
      {% for author in entry.author_array %}
        {% assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
        {% assign author_is_self = false %}
        {% if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first %}
          {% assign author_is_self = true %}
        {% endif %}
        {% assign clean_last_name = author_last_name | downcase | remove_accents %}
        {% assign coauthor_url = null %}
        {% if site.data.coauthors[clean_last_name] %}
          {% for coauthor in site.data.coauthors[clean_last_name] %}
            {% if coauthor.firstname contains author.first %}
              {% assign coauthor_url = coauthor.url %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if author_is_self %}<strong>{% elsif coauthor_url %}<a href="{{ coauthor_url }}">{% endif %}
        {{- author.first }} {{ author.last -}}
        {% if author_is_self %}</strong>{% elsif coauthor_url %}</a>{% endif %}
        {%- unless forloop.last %}<span aria-hidden="true"> · </span>{% endunless %}
      {% endfor %}
    </p>
  </header>

  <p class="publication-meta">
    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    {% assign theses = 'thesis,mastersthesis,phdthesis' | split: ',' %}
    {% if entry.type == 'article' and entry.journal %}<em>{{ entry.journal }}</em>{% endif %}
    {% if proceedings contains entry.type and entry.booktitle %}<em>{{ entry.booktitle }}</em>{% endif %}
    {% if theses contains entry.type and entry.school %}<em>{{ entry.school }}</em>{% endif %}
    {% if entry.volume %} {{ entry.volume }}{% endif %}
    {% if entry.number %}({{ entry.number }}){% endif %}
    {% if entry.pages %}, {{ entry.pages }}{% endif %}
    {% if entry.year %}<span class="publication-year">{{ entry.year }}</span>{% endif %}
    {% if entry.note %}<span>{{ entry.note }}</span>{% endif %}
  </p>

  <div class="publication-actions" aria-label="Resources for {{ entry.title | strip_html }}">
    {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">doi</a>{% endif %}
    {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
    {% if entry.html %}
      {% if entry.html contains '://' %}
        <a href="{{ entry.html }}">article</a>
      {% else %}
        <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}">article</a>
      {% endif %}
    {% endif %}
    {% if entry.pdf %}
      {% if entry.pdf contains '://' %}
        <a href="{{ entry.pdf }}">PDF</a>
      {% else %}
        <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">PDF</a>
      {% endif %}
    {% endif %}
    {% if entry.code %}<a href="{{ entry.code }}">code</a>{% endif %}
    {% if entry.slides %}
      {% if entry.slides contains '://' %}
        <a href="{{ entry.slides }}">slides</a>
      {% else %}
        <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}">slides</a>
      {% endif %}
    {% endif %}
    {% if entry.poster %}
      {% if entry.poster contains '://' %}
        <a href="{{ entry.poster }}">poster</a>
      {% else %}
        <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}">poster</a>
      {% endif %}
    {% endif %}
  </div>

  {% if entry.abstract or entry.bibtex_show %}
    <div class="publication-details">
      {% if entry.abstract %}
        <details>
          <summary>abstract</summary>
          <p>{{ entry.abstract }}</p>
        </details>
      {% endif %}
      {% if entry.bibtex_show %}
        <details>
          <summary>bibtex</summary>
          <pre><code>{{ entry.bibtex }}</code></pre>
        </details>
      {% endif %}
    </div>
  {% endif %}
</article>
