---
layout: default
---
<article class="home-shell">
  <div class="prose home-intro">{{ content }}</div>

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section">
      <div class="section-heading">
        <h2>recent updates</h2>
        <a href="{{ '/news/' | relative_url }}">full log →</a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  <nav class="profile-links" aria-label="Profiles and public key">
    {% if site.data.socials.scholar_userid %}
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
    {% endif %}
    {% if site.data.socials.orcid_id %}<a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID</a>{% endif %}
    {% if site.data.socials.github_username %}<a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>{% endif %}
    <a href="{{ '/assets/pgp/sanchit-srivastava.asc' | relative_url }}">PGP key</a>
  </nav>
</article>
