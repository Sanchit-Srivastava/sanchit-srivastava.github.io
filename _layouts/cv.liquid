---
layout: default
---
{% assign cv = site.data.cv.cv %}

<article class="page-shell cv-shell">
  <header class="page-header cv-header">
    <div>
      <h1>{{ page.title }}</h1>
      {% if page.description %}
        <p class="page-description">{{ page.description }}</p>
      {% endif %}
    </div>
    {% if page.cv_pdf %}
      <a class="text-button" href="{{ page.cv_pdf | relative_url }}">download PDF</a>
    {% endif %}
  </header>

  {% if cv %}
    <section class="cv-summary" aria-label="Contact information">
      <div><span>name</span>{{ cv.name }}</div>
      <div><span>role</span>{{ cv.label }}</div>
      <div>
        <span>email</span><a href="mailto:{{ cv.email }}">{{ cv.email }}</a>
      </div>
      <div><span>location</span>{{ cv.location }}</div>
    </section>

    {% if cv.summary %}
      <p class="cv-intro">{{ cv.summary }}</p>
    {% endif %}

    {% assign empty_array = '' | split: ',' %}
    {% assign experience = cv.sections.Experience | default: empty_array %}
    {% assign volunteer = cv.sections.Volunteer | default: empty_array %}
    {% assign combined_experience = experience | concat: volunteer %}
    {% if combined_experience.size > 0 %}
      <section class="cv-section" id="experience">
        <h2>experience</h2>
        {% assign entries = combined_experience %}
        {% include cv/experience.liquid %}
      </section>
    {% endif %}

    {% for section_pair in cv.sections %}
      {% assign section_title = section_pair[0] %}
      {% assign entries = section_pair[1] %}
      {% if section_title == 'Experience' or section_title == 'Volunteer' %}{% continue %}{% endif %}
      <section class="cv-section" id="{{ section_title | slugify }}">
        <h2>{{ section_title | downcase }}</h2>
        {% case section_title %}
          {% when 'Education' %}
            {% include cv/education.liquid %}
          {% when 'Teaching' %}
            {% include cv/experience.liquid %}
          {% when 'Awards', 'Honors and Awards' %}
            {% include cv/awards.liquid %}
          {% when 'Publications' %}
            {% include cv/publications.liquid %}
          {% when 'Skills' %}
            {% include cv/skills.liquid %}
          {% when 'Languages' %}
            {% include cv/languages.liquid %}
          {% when 'Interests', 'Academic Interests' %}
            {% include cv/interests.liquid %}
          {% else %}
            <div class="cv-generic-list">
              {% for entry in entries %}
                {% if entry.label %}
                  <p>
                    <strong>{{ entry.label }}:</strong> {{ entry.details }}
                  </p>
                {% endif %}
                {% if entry.bullet %}{{ entry.bullet | markdownify }}{% endif %}
              {% endfor %}
            </div>
        {% endcase %}
      </section>
    {% endfor %}
  {% else %}
    <p>CV data is currently unavailable.</p>
  {% endif %}
</article>
